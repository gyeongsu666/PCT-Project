{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "PCT.Api 실행 (web)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/PCT.Api/bin/Debug/net10.0/PCT.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/PCT.Api",
      "stopAtEntry": false,
      "console": "internalConsole",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    }
  ]
}
